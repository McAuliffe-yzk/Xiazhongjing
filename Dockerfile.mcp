FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8080 \
    XIANGZHONGJING_DATA_DIR=/data

WORKDIR /app

COPY requirements.txt requirements-mcp.txt ./
RUN pip install --no-cache-dir -r requirements-mcp.txt

COPY . ./
RUN mkdir -p /data

EXPOSE 8080
CMD ["python", "mcp_server.py"]
