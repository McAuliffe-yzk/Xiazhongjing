# ============================================
# 匣中镜 AI Vlogger Studio 环境配置
# 复制此文件为 .env，并填入真实的 API 密钥
# ============================================

# ---- 核心模型：DeepSeek ----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_TIMEOUT_SECONDS=75

# ---- 实时来源增强：Tavily（可选；仅用于书中人，不参与文案生成书库支撑） ----
TAVILY_API_KEY=tvly-your-tavily-api-key
TAVILY_API_BASE=https://api.tavily.com

# ---- Image 2.0：封面图生成 ----
IMAGE_API_KEY=sk-your-image-api-key
IMAGE_API_BASE=https://api.openai.com
IMAGE_MODEL=gpt-image-2

# ---- Skill 运行策略 ----
SKILL_MAX_ATTEMPTS=1

# ---- 匣中镜数据 ----
# 为空时使用系统应用数据目录：macOS 为 Application Support，Windows 为 LOCALAPPDATA
XIANGZHONGJING_DATA_DIR=

# 可选：为“导入本机阅读笔记”按钮配置已存在的文件路径
XIANGZHONGJING_MUSK_NOTE_PATH=
XIANGZHONGJING_JIANLAI_NOTE_PATH=
XIANGZHONGJING_DAODE_NOTE_PATH=

# ---- 服务 ----
# 单人本地版默认仅本机可访问；不要在不可信网络中改为 0.0.0.0
HOST=127.0.0.1
PORT=8860
